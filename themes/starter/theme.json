{
  "$schema": "https://codedrobe.app/schemas/theme-manifest.schema.json",
  "schemaVersion": 1,
  "id": "buddyhue-starter",
  "displayName": "BuddyHue Starter",
  "version": "0.1.0",
  "copy": {
    "tagline": "A safe starter theme for WorkBuddy 5.9.x."
  },
  "targets": {
    "workbuddy": {
      "css": "workbuddy.css",
      "verification": {
        "recommended": [
          {
            "name": "composer",
            "any": [
              "[role='textbox'][contenteditable='true']",
              ".wb-home-composer [contenteditable='true']"
            ]
          }
        ]
      }
    }
  }
}
