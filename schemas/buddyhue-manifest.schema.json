{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buddyhue.dev/schemas/manifest-v1.json",
  "title": "BuddyHue theme source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "compatibility", "css"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 32 }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "css": { "type": "string", "minLength": 1 },
    "images": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
      "additionalProperties": { "type": "string", "pattern": "\\.(?:png|jpe?g|webp|gif)$" }
    },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "$defs": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbuddy"],
      "properties": {
        "workbuddy": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+ <\\d+\\.\\d+\\.\\d+$" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "any"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "any": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
        "recommended": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
        "contexts": { "type": "array", "minItems": 1 }
      },
      "anyOf": [
        { "required": ["required"] },
        { "required": ["recommended"] },
        { "required": ["contexts"] }
      ]
    }
  }
}
